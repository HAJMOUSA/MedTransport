# ─── MidTransport PRODUCTION Environment Variables ───────────────────────────
# Copy to .env on the server and fill in every value. Never commit the real .env.

# ─── Public domain (no https://, no port) — Caddy gets TLS for this name ──────
DOMAIN=midtransport.example.com

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=midtransport
POSTGRES_USER=midtransport
POSTGRES_PASSWORD=__GENERATE_STRONG_PASSWORD__
DATABASE_SSL=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE_STRONG_PASSWORD__

# ─── API Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Generate each with: openssl rand -base64 48
JWT_SECRET=__GENERATE_48_RANDOM_CHARS__
JWT_REFRESH_SECRET=__GENERATE_48_RANDOM_CHARS__
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend ────────────────────────────────────────────────────────────────
# Empty = same-origin through nginx proxy (correct for this deployment)
VITE_API_URL=""

# ─── Twilio (SMS — OTP) ──────────────────────────────────────────────────────
# Leave blank to run in dev-SMS mode (OTP codes appear in `docker compose logs api`)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── SendGrid (optional email) ───────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=MidTransport

# ─── App Settings ────────────────────────────────────────────────────────────
ORG_NAME=Your Transport Company
# Must be the public HTTPS origin — used in SMS links and CORS
APP_BASE_URL=https://midtransport.example.com
OTP_EXPIRY_SECONDS=600
GEOFENCE_ARRIVAL_RADIUS_M=100
GPS_UPDATE_INTERVAL_S=10
ORG_TIMEZONE=America/New_York
